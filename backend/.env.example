# Copy this file to .env and replace all example values before starting the backend.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./logistics.db

# Generate a private random key (example: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-a-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated exact frontend origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false

# Optional email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
